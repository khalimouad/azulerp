# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: Random server-only secret, at least 32 characters.
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Initial administrator credentials used only when creating a new database.
INITIAL_ADMIN_PASSWORD="CHOOSE_A_STRONG_PASSWORD"
INITIAL_ADMIN_PIN="CHOOSE_A_PRIVATE_PIN"

# DATABASE_URL: Neon PostgreSQL connection string (Recommended with PgBouncer connection pooling)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# DATABASE_URL_UNPOOLED: Direct Neon PostgreSQL connection without pgbouncer
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# PG Parameters for custom connection construction
PGHOST="HOST-pooler.neon.tech"
PGHOST_UNPOOLED="HOST.neon.tech"
PGUSER="USER"
PGDATABASE="DATABASE"
PGPASSWORD="PASSWORD"

# Vercel Postgres environment variables
POSTGRES_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
POSTGRES_USER="USER"
POSTGRES_HOST="HOST-pooler.neon.tech"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_DATABASE="DATABASE"
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?connect_timeout=15&sslmode=require"


